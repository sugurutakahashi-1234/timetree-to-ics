{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"outDir": "dist",
		"rootDir": "src",
		"declaration": true,
		"sourceMap": false,
		"rewriteRelativeImportExtensions": true,
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"types": ["node"]
	},
	"include": ["src"]
}
