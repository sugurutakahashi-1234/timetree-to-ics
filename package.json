	"license": "MIT",
	"author": "Suguru Takahashi",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sugurutakahashi-1234/timetree-ics-feed.git"
	},
	"keywords": [
		"timetree",
		"ical",
		"ics",
		"icalendar",
		"google-calendar"
	],
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"bin": {
